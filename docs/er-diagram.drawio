;spacingLeft=8;fontSize=12;" vertex="1" parent="c49"><mxGeometry x="0" y="29" width="210" height="20" as="geometry"/></mxCell><mxCell id="c51" value="&lt;i&gt;action&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c49"><mxGeometry x="0" y="49" width="210" height="20" as="geometry"/></mxCell><mxCell id="c52" value="&lt;i&gt;entity&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c49"><mxGeometry x="0" y="69" width="210" height="20" as="geometry"/></mxCell><mxCell id="c53" value="&lt;i&gt;entity_id&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c49"><mxGeometry x="0" y="89" width="210" height="20" as="geometry"/></mxCell><mxCell id="c54" value="&lt;i&gt;details&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c49"><mxGeometry x="0" y="109" width="210" height="20" as="geometry"/></mxCell><mxCell id="c55" value="&lt;i&gt;created_at&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c49"><mxGeometry x="0" y="129" width="210" height="20" as="geometry"/></mxCell><mxCell id="c56" value="&lt;i&gt;writes&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;" vertex="1" parent="1"><mxGeometry x="325.0" y="111.0" width="130" height="70" as="geometry"/></mxCell><mxCell id="c57" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="c56" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" style="shape=link;html=1;rounded=0;width=4;" edge="1" parent="1" source="c56" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="592.0" y="305.0" width="146" height="80" as="geometry"/></mxCell><mxCell id="c60" value="&lt;i&gt;copy_of&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600.0" y="310.0" width="130" height="70" as="geometry"/></mxCell><mxCell id="c61" style="endArrow=classic;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="c60" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" style="shape=link;html=1;rounded=0;width=4;" edge="1" parent="1" source="c60" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="&lt;i&gt;lent_as&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600.0" y="605.0" width="130" height="70" as="geometry"/></mxCell><mxCell id="c64" style="endArrow=classic;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="c63" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" style="shape=link;html=1;rounded=0;width=4;" edge="1" parent="1" source="c63" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="&lt;i&gt;borrows&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;" vertex="1" parent="1"><mxGeometry x="325.0" y="751.0" width="130" height="70" as="geometry"/></mxCell><mxCell id="c67" style="endArrow=classic;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="c66" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" style="shape=link;html=1;rounded=0;width=4;" edge="1" parent="1" source="c66" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="&lt;i&gt;incurs&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870.0" y="751.0" width="130" height="70" as="geometry"/></mxCell><mxCell id="c70" style="endArrow=classic;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="c69" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" style="endArrow=classic;endFill=1;endSize=3;strokeWidth=5;html=1;rounded=0;" edge="1" parent="1" source="c69" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" style="endArrow=none;strokeWidth=2;strokeColor=#ffffff;html=1;rounded=0;targetPerimeterSpacing=12;" edge="1" parent="1" source="c69" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="&lt;i&gt;performs&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140.0" y="235.0" width="130" height="70" as="geometry"/></mxCell><mxCell id="c74" style="endArrow=classic;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="c73" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="c73" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="&lt;b&gt;Assumptions&lt;/b&gt;&lt;br&gt;1. A loan is an entity: the same member can borrow the same copy many times, and a fine belongs to one loan.&lt;br&gt;2. A copy exists only as a copy of a book. copy_no starts at 1 for each book, so book_copy is weak (owner book, discriminator copy_no).&lt;br&gt;3. Copies are withdrawn (withdrawn_at), never deleted, so loan history stays.&lt;br&gt;4. A loan has at most one fine, made when it is returned late. The fine&amp;#x27;s member is the loan&amp;#x27;s member.&lt;br&gt;5. fine.amount is stored: it is what was charged at the rate in force (20.00 per day late).&lt;br&gt;6. Every book has at least one author; an author can have no books yet.&lt;br&gt;7. activity_log.entity and entity_id record which row changed as history, not a link (the row may be deleted).&lt;br&gt;8. An activity_log entry with no admin was made by the system.&lt;br&gt;9. No multivalued attributes. A book&amp;#x27;s authors are the writes relationship.&lt;br&gt;10. No ISA, aggregation or recursive relationships are needed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;strokeColor=#000000;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="40" width="400" height="430" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;&lt;u&gt;attr&lt;/u&gt;  primary key&lt;br&gt;&lt;span style=&quot;text-decoration: underline dashed;&quot;&gt;attr&lt;/span&gt;  discriminator of a weak entity&lt;br&gt;attr ( )  derived attribute&lt;br&gt;indented attrs  parts of a composite attribute&lt;br&gt;double box / double diamond  weak entity / identifying relationship&lt;br&gt;arrow  one side;  plain line  many side&lt;br&gt;double line  total participation" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;strokeColor=#000000;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="500" width="400" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rel" name="Relational schema"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c78" value="&lt;b&gt;admin&lt;/b&gt;" style="swimlane;html=1;startSize=26;fillColor=#dae8fc;fontSize=14;collapsible=0;container=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="1240" y="40" width="250" height="112" as="geometry"/></mxCell><mxCell id="c79" value="&lt;u&gt;id&lt;/u&gt;  &lt;font color=&quot;#555555&quot;&gt;uuid&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c78"><mxGeometry x="0" y="29" width="250" height="20" as="geometry"/></mxCell><mxCell id="c80" value="email  &lt;font color=&quot;#555555&quot;&gt;text unique&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c78"><mxGeometry x="0" y="49" width="250" height="20" as="geometry"/></mxCell><mxCell id="c81" value="password_hash  &lt;font color=&quot;#555555&quot;&gt;text&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c78"><mxGeometry x="0" y="69" width="250" height="20" as="geometry"/></mxCell><mxCell id="c82" value="created_at  &lt;font color=&quot;#555555&quot;&gt;timestamptz&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c78"><mxGeometry x="0" y="89" width="250" height="20" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;author&lt;/b&gt;" style="swimlane;html=1;startSize=26;fillColor=#dae8fc;fontSize=14;collapsible=0;container=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="250" height="92" as="geometry"/></mxCell><mxCell id="c84" value="&lt;u&gt;id&lt;/u&gt;  &lt;font color=&quot;#555555&quot;&gt;uuid&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c83"><mxGeometry x="0" y="29" width="250" height="20" as="geometry"/></mxCell><mxCell id="c85" value="first_name  &lt;font color=&quot;#555555&quot;&gt;text&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c83"><mxGeometry x="0" y="49" width="250" height="20" as="geometry"/></mxCell><mxCell id="c86" value="last_name  &lt;font color=&quot;#555555&quot;&gt;text&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c83"><mxGeometry x="0" y="69" width="250" height="20" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;book&lt;/b&gt;" style="swimlane;html=1;startSize=26;fillColor=#dae8fc;fontSize=14;collapsible=0;container=1;ro