generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum BookGenre {
    FANTASY
    SCIFI
    HORROR
    ROMANCE
    MYSTERY
    THRILLER
    ADVENTURE
    DRAMA
    COMEDY
    OTHERS

    @@map("book_genre")
}

enum MemberStatus {
    ACTIVE
    SUSPENDED

    @@map("member_status")
}

enum ActivityAction {
    CREATE
    UPDATE
    DELETE

    @@map("activity_action")
}

enum ActivityEntity {
    book
    member
    loan
    fine
    author

    @@map("activity_entity")
}

model Admin {
    id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    email        String        @unique
    passwordHash String        @map("password_hash")
    createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
    activityLogs ActivityLog[]

    @@map("admin")
}

model Author {
    id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    firstName String       @map("first_name")
    lastName  String       @map("last_name")
    books     BookAuthor[]

    @@map("author")
}

model Book {
    id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    isbn        String       @unique @db.VarChar(13)
    title       String       @db.VarChar(255)
    description String?
    url         String?
    genre       BookGenre
    createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
    authors     BookAuthor[]
    copies      BookCopy[]

    @@map("book")
}

model BookCopy {
    bookId      String    @map("book_id") @db.Uuid
    copyNo      Int       @map("copy_no")
    acquiredAt  DateTime  @default(now()) @map("acquired_at") @db.Timestamptz(6)
    withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
    book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
    loans       Loan[]

    @@id([bookId, copyNo])
    @@map("book_copy")
}

model BookAuthor {
    bookId   String @map("book_id") @db.Uuid
    authorId String @map("author_id") @db.Uuid
    book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
    author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

    @@id([bookId, authorId])
    @@index([authorId])
    @@map("book_author")
}

model Member {
    id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    email     String       @unique @db.VarChar(255)
    firstName String       @map("first_name")
    lastName  String       @map("last_name")
    status    MemberStatus @default(ACTIVE)
    createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
    loans     Loan[]

    @@map("member")
}

model Loan {
    id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    bookId       String    @map("book_id") @db.Uuid
    copyNo       Int       @map("copy_no")
    memberId     String    @map("member_id") @db.Uuid
    checkoutDate DateTime  @default(now()) @map("checkout_date") @db.Timestamptz(6)
    dueDate      DateTime  @map("due_date") @db.Timestamptz(6)
    returnDate   DateTime? @map("return_date") @db.Timestamptz(6)
    copy         BookCopy  @relation(fields: [bookId, copyNo], references: [bookId, copyNo], onDelete: Restrict)
    member       Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
    fine         Fine?

    @@index([bookId, copyNo])
    @@index([memberId])
    @@map("loan")
}

model Fine {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    loanId    String    @unique @map("loan_id") @db.Uuid
    amount    Decimal   @db.Decimal(10, 2)
    paidAt    DateTime? @map("paid_at") @db.Timestamptz(6)
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Restrict)

    @@map("fine")
}

model ActivityLog {
    id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    adminId   String?        @map("admin_id") @db.Uuid
    action    ActivityAction
    entity    ActivityEntity
    entityId  String?        @map("entity_id") @db.Uuid
    details   Json?
    createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
    admin     Admin?         @relation(fields: [adminId], references: [id], onDelete: Restrict)

    @@index([createdAt(sort: Desc)], map: "activity_log_created_at_idx")
    @@index([entity, entityId], map: "activity_log_entity_idx")
    @@map("activity_log")
}
